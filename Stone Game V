class Solution {
public:

    int solve(vector<int>& a, int l, int r, vector<vector<int>>& dp) {

        if (l == r)
            return 0;

        if (dp[l][r] != -1)
            return dp[l][r];

        int ans = 0;

        int leftSum = 0;
        int total = 0;

        for (int i = l; i <= r; i++)
            total += a[i];

        for (int i = l; i < r; i++) {

            leftSum += a[i];

            int rightSum = total - leftSum;

            if (leftSum < rightSum) {
                ans = max(ans,
                          leftSum + solve(a, l, i, dp));
            }
            else if (rightSum < leftSum) {
                ans = max(ans,
                          rightSum + solve(a, i + 1, r, dp));
            }
            else {
                ans = max(ans,
                          leftSum + solve(a, l, i, dp));

                ans = max(ans,
                          rightSum + solve(a, i + 1, r, dp));
            }
        }

        return dp[l][r] = ans;
    }

    int stoneGameV(vector<int>& stoneValue) {

        int n = stoneValue.size();

        vector<vector<int>> dp(n, vector<int>(n, -1));

        return solve(stoneValue, 0, n - 1, dp);
    }
};
