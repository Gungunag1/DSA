class Solution {
public:
    int solve(int amount, int index, vector<int>& coins,
              vector<vector<int>>& dp) {

        if (amount == 0)
            return 1;

        if (index == coins.size())
            return 0;

        if (dp[index][amount] != -1)
            return dp[index][amount];

        int ways = 0;

        // Take current coin
        if (coins[index] <= amount) {
            ways += solve(amount - coins[index],
                          index, coins, dp);
        }

        // Don't take current coin
        ways += solve(amount, index + 1, coins, dp);

        return dp[index][amount] = ways;
    }

    int change(int amount, vector<int>& coins) {
        vector<vector<int>> dp(
            coins.size(),
            vector<int>(amount + 1, -1)
        );

        return solve(amount, 0, coins, dp);
    }
};
