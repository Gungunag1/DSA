class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {
        int n = nums.size();
        unordered_map<int, int> mp;
        int ans=-1;
        for (int i = 0; i <= n-k; i++) {
            unordered_set<int> st;
            for (int j = i; j < i + k; j++) {
                st.insert(nums[j]);
            }
            for(int x:st){
                mp[x]++;
            }

        }

        for(auto [x,freq]:mp){
            if(freq==1){
               ans=max(ans,x);
            }
        }
        return ans;
    }
};
